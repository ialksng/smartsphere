{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/work/projects/smartsphere/app/api/(.*)",
      "destination": "https://smartsphere-drat.onrender.com/api/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://smartsphere-drat.onrender.com/api/$1"
    },
    {
      "source": "/work/projects/smartsphere/app/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/work/projects/smartsphere/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
