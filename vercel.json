{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/work/projects/smartsphere/app/api/:match*",
      "destination": "https://smartsphere-drat.onrender.com/api/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://smartsphere-drat.onrender.com/api/:match*"
    },
    {
      "source": "/work/projects/smartsphere/app/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/work/projects/smartsphere/app/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/:match*",
      "destination": "/index.html"
    }
  ]
}
