{
  "name": "smartsphere",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SmartSphere AI Workspace - MERN Stack Monorepo",
  "main": "server.js",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix client run build",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "install:all": "npm --prefix client install && npm --prefix server install"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "pdf-parse": "^1.1.1"
  }
}
