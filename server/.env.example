# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartsphere?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789
JWT_EXPIRE=30d

# Frontend URL (For CORS and OAuth callbacks)
FRONTEND_URL=https://ialksng.me/work/projects/smartsphere/app

# Google OAuth Credentials (for Google Sign-In and Google Drive Linking)
# Create in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://ialksng.me/work/projects/smartsphere/app/api/cloud/google/callback
GOOGLE_AUTH_REDIRECT_URI=https://ialksng.me/work/projects/smartsphere/app/api/auth/google/callback

# Groq Cloud API Key
# Get your free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Nodemailer SMTP / Gmail Settings for Password Reset Emails
EMAIL_USER=ialksng@gmail.com
EMAIL_PASS=your-gmail-16-char-app-password
EMAIL_FROM=Alok Singh <no-reply@ialksng.me>
EMAIL_REPLY_TO=no-reply@ialksng.me
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

