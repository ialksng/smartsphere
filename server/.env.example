# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartsphere?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789
JWT_EXPIRE=30d

# Frontend URL (For CORS and OAuth callbacks)
FRONTEND_URL=https://ialksng.me/work/projects/smartsphere/app

# Google OAuth Credentials (for Google Sign-In and Google Drive Linking)
# Create in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/cloud/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# xAI Grok API Key
# Get your key from https://console.x.ai/
GROK_API_KEY=xai-your-grok-api-key-here
GROK_MODEL=grok-beta

# Optional: Nodemailer SMTP Settings for Forgot Password emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

